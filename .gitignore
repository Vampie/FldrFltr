# Build-output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Release/publish-output van het portable releasescript, en handmatig uitgepakte
# releases die de gebruiker zelf test — bevatten hun eigen runtime data
# (presets.json, settings.json) en horen niet in git.
/publish/
/release/
release_*/
*.zip

# Lokale scratch-map om de laatste build snel met de hand te draaien (zie release.ps1) — geen
# release-artefact, hoort niet in git.
/test_ACOT/

# Rider / VS Code
.idea/
.vscode/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Portable-configuratie die tijdens het lokaal testen ontstaat
presets.json
presets.backup.*.json
settings.json

# OS-ruis
Thumbs.db
desktop.ini
