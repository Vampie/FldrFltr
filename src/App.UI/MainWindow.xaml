<Window x:Class="FldrFltr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FldrFltr"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PageForegroundBrush}"
        Title="{local:Loc MainWindow.Title}"
        Height="680" Width="800" MinHeight="540" MinWidth="640">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- taal/thema -->
            <RowDefinition Height="Auto" /> <!-- drie velden -->
            <RowDefinition Height="Auto" /> <!-- hernoemen: eigen kaart -->
            <RowDefinition Height="Auto" /> <!-- actiekaart: testen/opslaan/naamconflict -->
            <RowDefinition Height="Auto" /> <!-- presets: sized to content, capped via the ListBox's MaxHeight -->
            <RowDefinition Height="*" />    <!-- resultaat: takes all remaining space -->
        </Grid.RowDefinitions>

        <!-- Taal + thema: vanaf dag 1 zichtbaar en werkend (§1 van de projectbrief). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <TextBlock Text="{local:Loc Settings.Language}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="LanguageComboBox" Width="110" Margin="0,0,16,0"
                      SelectionChanged="LanguageComboBox_SelectionChanged" />
            <TextBlock Text="{local:Loc Settings.Theme}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ThemeComboBox" Width="220" SelectionChanged="ThemeComboBox_SelectionChanged" />
        </StackPanel>

        <!-- De drie invoervelden (§1). -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Loc Fields.Folder}" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="FolderTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" VerticalAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="2" Tag="Icons/icon-browse.png" Style="{StaticResource IconOnlyButton}" ToolTip="{local:Loc Fields.FolderBrowse}" Margin="0,0,0,8" Click="BrowseFolderButton_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Loc Fields.Extensions}" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="ExtensionsTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Loc Fields.Template}" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="TemplateTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" VerticalAlignment="Center" />

                <Button Grid.Row="3" Grid.Column="1" Content="{local:Loc Fields.InsertVariable}"
                        Tag="Icons/icon-insert-variable.png" Style="{StaticResource IconButton}"
                        HorizontalAlignment="Left" Click="InsertVariableButton_Click" />
            </Grid>
        </Border>

        <!-- Hernoemen: eigen rij, geen kaart, volle canvasbreedte. -->
        <Button x:Name="RenameButton" Grid.Row="2" Content="{local:Loc Buttons.Rename}" Tag="Icons/icon-run.png" Style="{StaticResource IconButton}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10" Margin="0,0,0,12" Click="RenameButton_Click" />

        <!-- Actieknoppen (§1: altijd eerst Testen (dry-run), nooit stilzwijgend overschrijven) — in
             hun eigen kaart, zelfde stijl als de andere blokken. "Bij naamconflict" rechts
             uitgelijnd, los van Testen/Opslaan links. -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{local:Loc Fields.ConflictPolicy}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="ConflictPolicyComboBox" Width="220" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TestDryRunButton" Content="{local:Loc Buttons.TestDryRun}" Tag="Icons/icon-inspect.png" Style="{StaticResource IconButton}" Margin="0,0,8,0" Click="TestDryRunButton_Click" />
                    <Button x:Name="SaveAsPresetButton" Content="{local:Loc Buttons.SaveAsPreset}" Tag="Icons/icon-save.png" Style="{StaticResource IconButton}" Click="SaveAsPresetButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bewaarde presets (§1/§4). -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{local:Loc Presets.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="PresetsEmptyTextBlock" DockPanel.Dock="Top" Text="{local:Loc Presets.Empty}" Opacity="0.7" />
                <ListBox x:Name="PresetsListBox" BorderThickness="0" Background="Transparent" MaxHeight="96"
                         MouseDoubleClick="PresetsListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <!-- The default ListBoxItem chrome (WPF's classic theme) carries its own
                             Padding/MinHeight, taller than this row's actual content — leaving a
                             blank-looking strip above/below the text. Zeroed out here since we
                             already draw our own compact row. -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Dubbelklikken op de rij laadt de preset (zie
                                 PresetsListBox_MouseDoubleClick) — geen aparte "Laden"-knop meer. -->
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Tag="Icons/icon-delete.png" Style="{StaticResource IconOnlyButton}" ToolTip="{local:Loc Buttons.Delete}" Padding="6,4" Margin="8,0,0,0" Click="PresetDeleteButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Resultaat-tabel na Testen/Hernoemen (§1). -->
        <Border Grid.Row="5" Style="{StaticResource CardBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{local:Loc Results.Title}" FontWeight="SemiBold" />
                    <!-- Geen echte voortgangsbalk nodig — enkel een simpele statustekst zodat
                         zichtbaar is dat de app aan het testen/hernoemen is, en wanneer het klaar
                         is. -->
                    <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Right" HorizontalAlignment="Right" Opacity="0.8" />
                </DockPanel>
                <DataGrid x:Name="ResultsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{local:Loc Results.ColumnFrom}" Binding="{Binding From}" Width="*" />
                        <DataGridTextColumn Header="{local:Loc Results.ColumnTo}" Binding="{Binding To}" Width="*" />
                        <DataGridTextColumn Header="{local:Loc Results.ColumnStatus}" Binding="{Binding StatusText}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
