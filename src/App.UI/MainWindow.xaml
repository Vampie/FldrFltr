<Window x:Class="FldrFltr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FldrFltr"
        Title="{local:Loc MainWindow.Title}"
        Height="620" Width="800" MinHeight="480" MinWidth="640">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- taal/thema -->
            <RowDefinition Height="Auto" /> <!-- drie velden -->
            <RowDefinition Height="Auto" /> <!-- actieknoppen -->
            <RowDefinition Height="*" />    <!-- presets -->
            <RowDefinition Height="2*" />   <!-- resultaat -->
        </Grid.RowDefinitions>

        <!-- Taal + thema: vanaf dag 1 zichtbaar en werkend (§1 van de projectbrief). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
            <TextBlock Text="{local:Loc Settings.Language}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="LanguageComboBox" Width="90" Margin="0,0,16,0"
                      SelectionChanged="LanguageComboBox_SelectionChanged" />
            <TextBlock Text="{local:Loc Settings.Theme}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ThemeComboBox" Width="110" SelectionChanged="ThemeComboBox_SelectionChanged" />
        </StackPanel>

        <!-- De drie invoervelden (§1). -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{local:Loc Fields.Folder}" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="FolderTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,8" VerticalAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="2" Content="{local:Loc Fields.FolderBrowse}" Margin="0,0,0,8" Click="BrowseFolderButton_Click" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{local:Loc Fields.Extensions}" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="ExtensionsTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{local:Loc Fields.Template}" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox x:Name="TemplateTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8" VerticalAlignment="Center" />

                <Button Grid.Row="3" Grid.Column="1" Content="{local:Loc Fields.InsertVariable}"
                        HorizontalAlignment="Left" Click="InsertVariableButton_Click" />
            </Grid>
        </Border>

        <!-- Actieknoppen (§1: altijd eerst Testen (dry-run), nooit stilzwijgend overschrijven). -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="TestDryRunButton" Content="{local:Loc Buttons.TestDryRun}" Margin="0,0,8,0" Padding="12,6" Click="TestDryRunButton_Click" />
            <Button x:Name="RenameButton" Content="{local:Loc Buttons.Rename}" Margin="0,0,8,0" Padding="12,6" Click="RenameButton_Click" />
            <Button x:Name="SaveAsPresetButton" Content="{local:Loc Buttons.SaveAsPreset}" Padding="12,6" Click="SaveAsPresetButton_Click" />
        </StackPanel>

        <!-- Bewaarde presets (§1, opgebouwd in fase 3 — hier alvast het lege lijst-frame). -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{local:Loc Presets.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox x:Name="PresetsListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Resultaat-tabel na Testen/Hernoemen (§1, gevuld in fase 2). -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{local:Loc Results.Title}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid x:Name="ResultsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{local:Loc Results.ColumnFrom}" Binding="{Binding From}" Width="*" />
                        <DataGridTextColumn Header="{local:Loc Results.ColumnTo}" Binding="{Binding To}" Width="*" />
                        <DataGridTextColumn Header="{local:Loc Results.ColumnStatus}" Binding="{Binding Status}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
