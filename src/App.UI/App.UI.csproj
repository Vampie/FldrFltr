<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>FldrFltr</RootNamespace>
    <AssemblyName>FldrFltr</AssemblyName>
    <!-- Keep InformationalVersion exactly what release.ps1 passes via -p:Version (e.g. "1.2.11") —
         the SDK otherwise appends "+<git-commit-hash>", which is noise in the titlebar. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ookii.Dialogs.WinForms" Version="4.0.0" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.VisualBasic.Interaction.InputBox — the simplest built-in "type a name" prompt,
         used when saving a preset. No custom prompt window needed for one text field. -->
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI text lives as plain files next to the exe, not embedded — adding a language is
         dropping in a new Languages\<code>.json, no rebuild needed. See Localization/LocExtension. -->
    <None Include="Languages\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Extra accent palettes (§5 phase 4: Monokai/Solarized-inspired), same portable,
         no-rebuild-needed philosophy — see ThemeProvider. -->
    <None Include="Themes\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Core\App.Core.csproj" />
    <ProjectReference Include="..\App.Infrastructure\App.Infrastructure.csproj" />
  </ItemGroup>

</Project>
